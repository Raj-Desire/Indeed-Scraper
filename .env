SCRAPER_HEADLESS=true

# Request delays (seconds)
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
SCRAPER_MAX_PAGES=3
SCRAPER_RETRY_ATTEMPTS=3

# Filtering (720 hours = 30 days max job age)
FILTER_MAX_AGE_HOURS=720

# Dashboard Server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Output Directories
OUTPUT_DIR=outputs
LOG_DIR=logs
